<% layout("./layouts/boilerplate") %>
<body>
    <H2>All Listings</H2>

    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
      <%for(let listing of allListings){%>
      <a href="/Listings/<%= listing._id %>" class="listinglink"> 
<div class="card " >
  <img src="<%= listing.image.url %>" class="card-img-top" alt="Listings-img"style="height: 20rem;">
 <div class="card-img-overlay"></div>
  <div class="card-body">
    <h5 class="card-title"><%= listing.Title %></h5>
    <P><b>(<%=listing.location%>,<%= listing.country %>)</b></P>
    <p class="card-text">
       <b>&#8377; <%=listing.price.toLocaleString('en-IN')%></b> / night
    </p>
    
    
  </div>
</div>
</a>


<%}%>
    </div>


</body>

