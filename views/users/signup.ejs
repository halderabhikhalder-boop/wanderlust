<% layout("./layouts/boilerplate") %>
<h2 class="col-6 offset-3">Signup for Wanderlust</h2>

<div class="row mt-3">
    <div class="col-6 offset-3">

    <form action="/signup" method="post" class="needs-validation" novalidate>
          <div class="mb-3">
        <label for="username" class="form-label"><b>Username</b></label>
        <input name="username" placeholder="Enter username" id="username" type="text" class="form-control" required>
           <div class="invalid-feedback">
       Please enter username!
      </div>
         <div class="valid-feedback">
      Looks Good!
      </div>
        </div>
           <div class="mb-3">
        <label for="email" class="form-label"><b>Email</b></label>
        <input name="email" placeholder="Enter email" id="email" type="text" class="form-control" required>
           <div class="invalid-feedback">
       Please enter email!
      </div>
         <div class="valid-feedback">
      Looks Good!
      </div>
        </div>
           <div class="mb-3">
        <label for="password" class="form-label"><b>Password:</b></label>
        <input name="password" placeholder="Enter password" id="password" type="password" class="form-control" required>
           <div class="invalid-feedback">
       Please enter password!
      </div>
         <div class="valid-feedback">
      Looks Good!
      </div>
        </div>
        <button class="success">Signup</button>

    </form>


        </div>
        </div>